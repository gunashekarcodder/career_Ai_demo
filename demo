<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CareerAI — Full App Design Script</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;1,9..144,300&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #0A0B14;
  --ink2: #111222;
  --ink3: #1A1C30;
  --panel: #161828;
  --border: #252840;
  --teal: #00E5C8;
  --teal-dim: #00B89F;
  --gold: #FFD166;
  --rose: #FF6B9D;
  --violet: #8B5CF6;
  --text: #E8EAF6;
  --muted: #7B7FA8;
  --success: #22D3A7;
  --warning: #FFB547;
  --error: #FF6B6B;
  --glow: 0 0 30px rgba(0,229,200,0.15);
}

* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  background: var(--ink);
  color: var(--text);
  font-family: 'DM Mono', monospace;
  font-size: 14px;
  line-height: 1.6;
  overflow-x: hidden;
}

/* ── NAV ── */
.design-nav {
  position: sticky; top:0; z-index:100;
  background: rgba(10,11,20,0.95);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  padding: 0 48px;
  display: flex; align-items:center; justify-content:space-between;
  height: 64px;
}
.nav-logo { font-family:'Syne',sans-serif; font-size:18px; font-weight:800; color:var(--teal); letter-spacing:-0.5px; }
.nav-logo span { color: var(--text); }
.nav-links { display:flex; gap:6px; flex-wrap:wrap; }
.nav-links a {
  color: var(--muted); font-size:11px; text-decoration:none;
  padding: 5px 12px; border-radius:20px;
  border: 1px solid transparent;
  transition: all .2s;
}
.nav-links a:hover { color:var(--teal); border-color:var(--teal); }

/* ── HERO ── */
.hero {
  min-height: 100vh;
  display: flex; align-items:center; justify-content:center;
  position: relative; overflow:hidden;
  padding: 80px 48px;
  text-align: center;
}
.hero-bg {
  position:absolute; inset:0;
  background:
    radial-gradient(ellipse 80% 60% at 50% -20%, rgba(0,229,200,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 80% 80%, rgba(139,92,246,0.06) 0%, transparent 50%),
    radial-gradient(ellipse 40% 30% at 10% 70%, rgba(255,107,157,0.04) 0%, transparent 40%);
}
.hero-grid {
  position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(37,40,64,0.4) 1px, transparent 1px),
    linear-gradient(90deg, rgba(37,40,64,0.4) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 100%);
}
.hero-content { position:relative; z-index:2; max-width:900px; }
.hero-badge {
  display:inline-flex; align-items:center; gap:8px;
  padding: 6px 16px; border-radius:20px;
  border: 1px solid rgba(0,229,200,0.3);
  background: rgba(0,229,200,0.05);
  font-size:11px; color:var(--teal); letter-spacing:2px; text-transform:uppercase;
  margin-bottom: 32px;
}
.hero-badge::before {
  content:''; width:6px; height:6px; border-radius:50%;
  background:var(--teal); animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(0.8)} }

h1.hero-title {
  font-family:'Syne',sans-serif; font-size:clamp(48px,7vw,96px);
  font-weight:800; line-height:0.95; letter-spacing:-3px;
  color: var(--text);
  margin-bottom: 8px;
}
h1.hero-title span { color: var(--teal); }
.hero-sub {
  font-family:'Fraunces',serif; font-style:italic; font-weight:300;
  font-size:clamp(18px,2.5vw,28px); color:var(--muted); margin-bottom:16px;
}
.hero-desc { font-size:14px; color:var(--muted); max-width:600px; margin:0 auto 48px; line-height:1.8; }

.hero-stats {
  display:flex; justify-content:center; gap:48px; margin-top:64px;
  border-top: 1px solid var(--border); padding-top:48px;
}
.stat-item { text-align:left; }
.stat-num { font-family:'Syne',sans-serif; font-size:32px; font-weight:800; color:var(--teal); display:block; }
.stat-lbl { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; }

/* ── SECTIONS ── */
.section {
  padding: 100px 48px;
  max-width: 1400px; margin:0 auto;
}
.section-header { margin-bottom:64px; }
.section-tag {
  display:inline-block; font-size:10px; letter-spacing:3px; text-transform:uppercase;
  color:var(--teal); padding:4px 12px; border:1px solid rgba(0,229,200,0.3);
  border-radius:20px; margin-bottom:16px;
}
.section-title {
  font-family:'Syne',sans-serif; font-size:clamp(28px,4vw,48px);
  font-weight:700; letter-spacing:-1px; line-height:1.1;
}
.section-title span { color:var(--teal); }
.section-desc { font-size:14px; color:var(--muted); max-width:500px; line-height:1.8; margin-top:16px; }

/* ── FULL-WIDTH SECTION ── */
.section-full { padding:100px 48px; }
.section-full .section-header { max-width:1400px; margin:0 auto 64px; }

/* ── SCREEN CARD ── */
.screen-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(380px,1fr)); gap:32px; }

.screen-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px; overflow:hidden;
  transition: all .3s; position:relative;
}
.screen-card:hover {
  border-color: rgba(0,229,200,0.4);
  transform: translateY(-4px);
  box-shadow: var(--glow), 0 24px 48px rgba(0,0,0,0.4);
}
.screen-label {
  position:absolute; top:16px; right:16px;
  background: rgba(0,229,200,0.1); color:var(--teal);
  font-size:10px; letter-spacing:2px; text-transform:uppercase;
  padding:4px 10px; border-radius:10px; border:1px solid rgba(0,229,200,0.2);
  z-index:5;
}
.screen-mockup {
  width:100%; aspect-ratio:9/16; max-height:500px;
  position:relative; overflow:hidden;
  background: var(--ink2);
}
.screen-info { padding:24px; }
.screen-name { font-family:'Syne',sans-serif; font-size:16px; font-weight:700; margin-bottom:6px; }
.screen-desc-text { font-size:12px; color:var(--muted); line-height:1.7; margin-bottom:16px; }
.feature-tags { display:flex; flex-wrap:wrap; gap:6px; }
.feat-tag {
  font-size:10px; padding:3px 8px; border-radius:6px;
  background: rgba(139,92,246,0.1); color: rgba(139,92,246,0.9);
  border: 1px solid rgba(139,92,246,0.2);
}

/* ── PHONE MOCKUP ── */
.phone-frame {
  width:100%; height:100%;
  background: var(--ink2);
  font-size:12px;
  padding:16px;
  overflow:hidden;
}
.phone-status {
  display:flex; justify-content:space-between; align-items:center;
  font-size:10px; color:var(--muted); margin-bottom:12px;
}
.phone-content { height:calc(100% - 30px); overflow:hidden; }

/* ── AUTH SCREENS ── */
.auth-frame {
  background: linear-gradient(160deg, #0F1022 0%, #0A0B14 100%);
  height:100%; padding:20px 16px; position:relative; overflow:hidden;
}
.auth-glow {
  position:absolute; top:-30px; left:50%; transform:translateX(-50%);
  width:200px; height:200px; border-radius:50%;
  background: radial-gradient(circle, rgba(0,229,200,0.12) 0%, transparent 70%);
  pointer-events:none;
}
.auth-logo-sm { font-family:'Syne',sans-serif; font-size:13px; font-weight:800; color:var(--teal); margin-bottom:24px; text-align:center; }
.auth-title-sm { font-family:'Syne',sans-serif; font-size:18px; font-weight:700; margin-bottom:4px; color:var(--text); }
.auth-sub-sm { font-size:10px; color:var(--muted); margin-bottom:20px; }
.input-group-sm { margin-bottom:10px; }
.input-label-sm { font-size:9px; color:var(--muted); letter-spacing:1px; text-transform:uppercase; margin-bottom:4px; }
.input-field-sm {
  width:100%; background:rgba(37,40,64,0.6); border:1px solid var(--border);
  border-radius:8px; padding:8px 10px; color:var(--text); font-size:11px;
  font-family:'DM Mono',monospace;
}
.input-field-sm.focused { border-color:var(--teal); box-shadow: 0 0 0 2px rgba(0,229,200,0.1); }
.btn-primary-sm {
  width:100%; background: linear-gradient(135deg, var(--teal), var(--teal-dim));
  color: var(--ink); border:none; border-radius:8px; padding:10px;
  font-family:'Syne',sans-serif; font-size:12px; font-weight:700; cursor:pointer;
  margin-top:12px; text-align:center;
}
.btn-google-sm {
  width:100%; background:rgba(255,255,255,0.05); color:var(--text);
  border:1px solid var(--border); border-radius:8px; padding:9px;
  font-size:11px; cursor:pointer; margin-top:8px; text-align:center;
  display:flex; align-items:center; justify-content:center; gap:8px;
}
.google-icon { width:12px; height:12px; }
.divider-sm { display:flex; align-items:center; gap:8px; margin:12px 0; }
.divider-sm::before, .divider-sm::after { content:''; flex:1; height:1px; background:var(--border); }
.divider-sm-text { font-size:9px; color:var(--muted); }
.auth-link-sm { font-size:10px; color:var(--teal); text-align:center; margin-top:12px; cursor:pointer; }
.social-row { display:flex; gap:8px; margin-top:8px; }
.social-btn-sm { flex:1; background:rgba(255,255,255,0.04); border:1px solid var(--border); border-radius:8px; padding:8px; text-align:center; font-size:10px; color:var(--muted); }
.terms-sm { font-size:9px; color:var(--muted); text-align:center; margin-top:12px; line-height:1.5; }
.terms-sm span { color:var(--teal); }

/* ONBOARDING */
.onboard-frame { background:var(--ink2); height:100%; padding:20px 16px; }
.step-dots { display:flex; gap:4px; justify-content:center; margin-bottom:24px; }
.dot { width:20px; height:3px; border-radius:2px; background:var(--border); }
.dot.active { background:var(--teal); width:32px; }
.onboard-icon { width:56px; height:56px; border-radius:16px; background:rgba(0,229,200,0.1); border:1px solid rgba(0,229,200,0.2); display:flex; align-items:center; justify-content:center; font-size:24px; margin:0 auto 16px; }
.onboard-title { font-family:'Syne',sans-serif; font-size:16px; font-weight:700; text-align:center; margin-bottom:8px; }
.onboard-desc { font-size:11px; color:var(--muted); text-align:center; line-height:1.6; margin-bottom:24px; }
.choice-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:16px; }
.choice-btn { background:rgba(37,40,64,0.6); border:1px solid var(--border); border-radius:10px; padding:12px 8px; text-align:center; cursor:pointer; transition:.2s; }
.choice-btn.selected { border-color:var(--teal); background:rgba(0,229,200,0.08); }
.choice-btn .c-icon { font-size:20px; margin-bottom:4px; }
.choice-btn .c-label { font-size:10px; color:var(--muted); }
.choice-btn.selected .c-label { color:var(--teal); }

/* DASHBOARD */
.dash-frame { background:var(--ink); height:100%; overflow:hidden; }
.dash-header { background:var(--panel); border-bottom:1px solid var(--border); padding:12px 16px; display:flex; align-items:center; justify-content:space-between; }
.dash-avatar { width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--teal),var(--violet)); }
.dash-greeting { font-family:'Syne',sans-serif; font-size:11px; font-weight:700; }
.dash-greeting span { color:var(--teal); }
.notif-dot { width:8px; height:8px; border-radius:50%; background:var(--rose); }

.dash-body { padding:12px 16px; overflow-y:auto; height:calc(100% - 52px - 52px); }
.career-score-card {
  background:linear-gradient(135deg, rgba(0,229,200,0.12), rgba(139,92,246,0.08));
  border:1px solid rgba(0,229,200,0.2); border-radius:16px; padding:16px; margin-bottom:12px;
}
.score-label { font-size:9px; text-transform:uppercase; letter-spacing:1px; color:var(--muted); margin-bottom:4px; }
.score-value { font-family:'Syne',sans-serif; font-size:36px; font-weight:800; color:var(--teal); line-height:1; }
.score-sub { font-size:10px; color:var(--muted); margin-top:4px; }
.score-bar-track { height:4px; background:rgba(255,255,255,0.08); border-radius:2px; margin-top:10px; }
.score-bar-fill { height:100%; width:72%; background:linear-gradient(90deg,var(--teal),var(--violet)); border-radius:2px; }

.section-sm-title { font-family:'Syne',sans-serif; font-size:11px; font-weight:700; margin:12px 0 8px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; }
.quick-actions { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:12px; }
.qa-btn { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:10px 8px; display:flex; flex-direction:column; gap:4px; cursor:pointer; }
.qa-icon { font-size:16px; }
.qa-label { font-size:9px; color:var(--muted); }
.qa-title-sm { font-size:10px; font-family:'Syne',sans-serif; font-weight:700; }

.recommendation-row { display:flex; flex-direction:column; gap:8px; }
.rec-card-sm { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:10px 12px; display:flex; align-items:center; gap:10px; }
.rec-icon-sm { font-size:18px; width:32px; height:32px; display:flex; align-items:center; justify-content:center; background:rgba(0,229,200,0.08); border-radius:8px; flex-shrink:0; }
.rec-info-sm .rec-title { font-size:11px; font-weight:600; font-family:'Syne',sans-serif; }
.rec-info-sm .rec-meta { font-size:9px; color:var(--muted); }
.rec-match { margin-left:auto; font-size:10px; color:var(--teal); font-weight:600; }

.bottom-nav { background:var(--panel); border-top:1px solid var(--border); padding:8px 16px; display:flex; justify-content:space-around; }
.bnav-item { display:flex; flex-direction:column; align-items:center; gap:2px; opacity:0.5; cursor:pointer; }
.bnav-item.active { opacity:1; color:var(--teal); }
.bnav-icon { font-size:18px; }
.bnav-label { font-size:8px; text-transform:uppercase; letter-spacing:0.5px; }

/* SKILL GAP */
.skill-frame { background:var(--ink); height:100%; padding:16px; overflow:hidden; }
.skill-header { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
.back-btn { width:28px; height:28px; border-radius:8px; background:var(--panel); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:12px; cursor:pointer; }
.skill-title-hdr { font-family:'Syne',sans-serif; font-size:14px; font-weight:700; }
.radar-placeholder { width:100%; aspect-ratio:1; max-height:160px; background:var(--panel); border:1px solid var(--border); border-radius:16px; margin-bottom:16px; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; }
.radar-bg-circles { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
.radar-bg-circles::before, .radar-bg-circles::after {
  content:''; position:absolute; border-radius:50%; border:1px solid rgba(0,229,200,0.1);
}
.radar-bg-circles::before { width:80%; height:80%; }
.radar-bg-circles::after { width:50%; height:50%; }
.radar-label { font-size:10px; color:var(--muted); z-index:2; }
.skill-bars { display:flex; flex-direction:column; gap:10px; }
.skill-bar-item {}
.skill-bar-top { display:flex; justify-content:space-between; margin-bottom:4px; }
.skill-name-sm { font-size:10px; font-family:'Syne',sans-serif; font-weight:600; }
.skill-pct { font-size:10px; color:var(--teal); }
.skill-track { height:6px; background:rgba(255,255,255,0.05); border-radius:3px; }
.skill-fill { height:100%; border-radius:3px; }
.skill-fill.high { background:linear-gradient(90deg,var(--teal),var(--success)); }
.skill-fill.mid { background:linear-gradient(90deg,var(--gold),var(--warning)); }
.skill-fill.low { background:linear-gradient(90deg,var(--rose),var(--error)); }

/* JOB BOARD */
.job-frame { background:var(--ink); height:100%; padding:0; overflow:hidden; }
.job-search { padding:12px 16px; background:var(--panel); border-bottom:1px solid var(--border); }
.search-bar { background:var(--ink2); border:1px solid var(--border); border-radius:10px; padding:8px 12px; display:flex; align-items:center; gap:8px; }
.search-bar .s-icon { font-size:14px; color:var(--muted); }
.search-bar .s-text { font-size:11px; color:var(--muted); }
.filter-row { display:flex; gap:6px; overflow-x:auto; padding:10px 16px; border-bottom:1px solid var(--border); }
.filter-chip { flex-shrink:0; padding:4px 10px; border-radius:20px; border:1px solid var(--border); font-size:9px; color:var(--muted); cursor:pointer; white-space:nowrap; }
.filter-chip.active { border-color:var(--teal); color:var(--teal); background:rgba(0,229,200,0.08); }
.job-list { padding:12px 16px; overflow-y:auto; height:calc(100% - 90px - 52px); }
.job-card-sm { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:12px; margin-bottom:8px; cursor:pointer; transition:.2s; }
.job-card-sm:hover { border-color:rgba(0,229,200,0.3); }
.job-card-top { display:flex; align-items:center; gap:10px; margin-bottom:8px; }
.company-logo-sm { width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,rgba(0,229,200,0.2),rgba(139,92,246,0.2)); display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; }
.job-info-sm .job-title-sm { font-size:11px; font-family:'Syne',sans-serif; font-weight:700; }
.job-info-sm .company-name-sm { font-size:10px; color:var(--muted); }
.match-badge { margin-left:auto; background:rgba(0,229,200,0.1); color:var(--teal); border:1px solid rgba(0,229,200,0.2); font-size:9px; padding:2px 7px; border-radius:6px; flex-shrink:0; }
.job-tags-sm { display:flex; gap:4px; flex-wrap:wrap; }
.jtag { font-size:9px; padding:2px 6px; border-radius:4px; background:rgba(255,255,255,0.04); color:var(--muted); border:1px solid var(--border); }
.salary-sm { font-size:10px; color:var(--gold); margin-top:6px; font-weight:600; }

/* RESUME */
.resume-frame { background:var(--ink); height:100%; padding:16px; overflow:hidden; }
.resume-card { background:white; border-radius:12px; padding:14px; color:#111; height:calc(100% - 80px); overflow:hidden; position:relative; }
.resume-hdr { display:flex; align-items:flex-start; gap:10px; margin-bottom:10px; border-bottom:2px solid #00E5C8; padding-bottom:8px; }
.resume-avatar-sm { width:36px; height:36px; border-radius:8px; background:linear-gradient(135deg,#00E5C8,#8B5CF6); flex-shrink:0; }
.resume-name-sm { font-family:'Syne',sans-serif; font-size:13px; font-weight:800; color:#0A0B14; }
.resume-role-sm { font-size:9px; color:#666; }
.resume-section-title { font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#00B89F; margin:8px 0 4px; }
.resume-item-sm { display:flex; align-items:flex-start; gap:4px; margin-bottom:3px; font-size:9px; color:#333; }
.resume-item-sm::before { content:'▸'; color:#00E5C8; font-size:8px; flex-shrink:0; margin-top:1px; }
.ai-score-overlay {
  position:absolute; bottom:0; left:0; right:0;
  background:linear-gradient(0deg, rgba(10,11,20,0.98) 0%, rgba(10,11,20,0.6) 100%);
  padding:12px; border-radius:0 0 12px 12px;
}
.ai-score-row { display:flex; align-items:center; justify-content:space-between; }
.ai-score-val { font-family:'Syne',sans-serif; font-size:22px; font-weight:800; color:var(--teal); }
.ai-score-label { font-size:9px; color:var(--muted); }
.ai-suggest { font-size:9px; color:var(--gold); margin-top:4px; }

/* ROADMAP */
.roadmap-frame { background:var(--ink); height:100%; padding:16px; overflow:hidden; }
.roadmap-title { font-family:'Syne',sans-serif; font-size:14px; font-weight:700; margin-bottom:16px; }
.roadmap-path { position:relative; padding-left:24px; }
.roadmap-path::before { content:''; position:absolute; left:7px; top:0; bottom:0; width:2px; background:linear-gradient(180deg,var(--teal) 0%,var(--violet) 50%,rgba(255,255,255,0.1) 100%); border-radius:1px; }
.road-step { position:relative; margin-bottom:14px; }
.road-step::before { content:''; position:absolute; left:-21px; top:6px; width:10px; height:10px; border-radius:50%; background:var(--panel); border:2px solid var(--border); }
.road-step.done::before { background:var(--teal); border-color:var(--teal); box-shadow:0 0 8px rgba(0,229,200,0.4); }
.road-step.active::before { background:var(--violet); border-color:var(--violet); box-shadow:0 0 8px rgba(139,92,246,0.5); }
.road-step-card { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:10px 12px; }
.road-step.done .road-step-card { border-color:rgba(0,229,200,0.2); }
.road-step.active .road-step-card { border-color:rgba(139,92,246,0.3); }
.road-step-title { font-size:11px; font-family:'Syne',sans-serif; font-weight:700; margin-bottom:2px; }
.road-step-sub { font-size:9px; color:var(--muted); }
.road-step-badge { display:inline-block; margin-top:5px; font-size:8px; padding:2px 7px; border-radius:5px; }
.badge-done { background:rgba(0,229,200,0.1); color:var(--teal); }
.badge-active { background:rgba(139,92,246,0.1); color:var(--violet); }
.badge-locked { background:rgba(255,255,255,0.05); color:var(--muted); }

/* MENTOR */
.mentor-frame { background:var(--ink); height:100%; padding:0; overflow:hidden; }
.mentor-list { padding:12px 16px; overflow-y:auto; height:calc(100% - 52px); }
.mentor-card-sm { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:12px; margin-bottom:10px; display:flex; gap:12px; align-items:flex-start; }
.mentor-avatar-sm { width:40px; height:40px; border-radius:50%; flex-shrink:0; border:2px solid var(--teal); overflow:hidden; background:linear-gradient(135deg,rgba(0,229,200,0.3),rgba(139,92,246,0.3)); display:flex; align-items:center; justify-content:center; font-size:18px; }
.mentor-name { font-size:11px; font-family:'Syne',sans-serif; font-weight:700; margin-bottom:2px; }
.mentor-role-sm { font-size:9px; color:var(--muted); margin-bottom:6px; }
.mentor-tags-sm { display:flex; gap:4px; flex-wrap:wrap; margin-bottom:6px; }
.mentor-tag-sm { font-size:8px; padding:2px 6px; border-radius:4px; background:rgba(139,92,246,0.1); color:rgba(139,92,246,0.9); border:1px solid rgba(139,92,246,0.2); }
.mentor-rating { font-size:10px; color:var(--gold); }
.book-btn-sm { margin-left:auto; background:linear-gradient(135deg,var(--teal),var(--teal-dim)); color:var(--ink); font-size:9px; padding:5px 10px; border-radius:6px; border:none; font-family:'Syne',sans-serif; font-weight:700; cursor:pointer; flex-shrink:0; }

/* ASSESSMENT */
.assess-frame { background:var(--ink); height:100%; padding:16px; overflow:hidden; }
.assess-progress { display:flex; align-items:center; gap:8px; margin-bottom:20px; }
.assess-prog-bar { flex:1; height:4px; background:rgba(255,255,255,0.05); border-radius:2px; }
.assess-prog-fill { height:100%; background:linear-gradient(90deg,var(--teal),var(--violet)); border-radius:2px; }
.assess-q-num { font-size:9px; color:var(--muted); }
.assess-question { font-family:'Syne',sans-serif; font-size:13px; font-weight:700; margin-bottom:8px; line-height:1.4; }
.assess-context { font-size:10px; color:var(--muted); margin-bottom:20px; }
.assess-options { display:flex; flex-direction:column; gap:8px; }
.assess-option { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:10px 12px; font-size:11px; cursor:pointer; transition:.2s; }
.assess-option:hover { border-color:var(--teal); }
.assess-option.selected { border-color:var(--teal); background:rgba(0,229,200,0.08); color:var(--teal); }
.assess-nav { display:flex; gap:8px; margin-top:16px; }
.assess-nav .prev { flex:1; background:var(--panel); border:1px solid var(--border); border-radius:8px; padding:9px; font-size:10px; text-align:center; cursor:pointer; }
.assess-nav .next { flex:2; background:linear-gradient(135deg,var(--teal),var(--teal-dim)); color:var(--ink); border:none; border-radius:8px; padding:9px; font-family:'Syne',sans-serif; font-size:10px; font-weight:700; cursor:pointer; text-align:center; }

/* ANALYTICS */
.analytics-frame { background:var(--ink); height:100%; padding:16px; overflow:hidden; }
.chart-placeholder { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:14px; margin-bottom:10px; }
.chart-title { font-size:10px; font-family:'Syne',sans-serif; font-weight:700; margin-bottom:10px; }
.mini-chart { display:flex; align-items:flex-end; gap:4px; height:60px; }
.mini-bar { flex:1; border-radius:3px 3px 0 0; background:rgba(0,229,200,0.3); position:relative; }
.mini-bar.highlight { background:linear-gradient(0deg,var(--teal),var(--violet)); }
.insight-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.insight-card { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:10px; }
.insight-val { font-family:'Syne',sans-serif; font-size:20px; font-weight:800; }
.insight-val.teal { color:var(--teal); }
.insight-val.gold { color:var(--gold); }
.insight-val.rose { color:var(--rose); }
.insight-lbl-sm { font-size:8px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; }

/* ── SPECS TABLE ── */
.spec-section { background: var(--panel); border:1px solid var(--border); border-radius:20px; padding:40px; margin-bottom:32px; }
.spec-section h3 { font-family:'Syne',sans-serif; font-size:20px; font-weight:700; margin-bottom:24px; }
.spec-section h3 span { color:var(--teal); }

.spec-table { width:100%; border-collapse:collapse; }
.spec-table th { text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:1.5px; color:var(--muted); padding:8px 12px; border-bottom:2px solid var(--border); }
.spec-table td { padding:10px 12px; border-bottom:1px solid rgba(37,40,64,0.8); font-size:12px; vertical-align:top; }
.spec-table tr:last-child td { border-bottom:none; }
.spec-table td:first-child { color:var(--teal); font-family:'DM Mono',monospace; white-space:nowrap; }
.spec-table td:nth-child(2) { color:var(--text); }
.spec-table td:last-child { color:var(--muted); }

/* ── ARCH DIAGRAM ── */
.arch-diagram {
  background: var(--ink2); border:1px solid var(--border); border-radius:20px;
  padding:48px; margin-bottom:32px; position:relative;
}
.arch-layer { margin-bottom:32px; }
.arch-layer-label { font-size:10px; text-transform:uppercase; letter-spacing:2px; color:var(--muted); margin-bottom:12px; }
.arch-boxes { display:flex; gap:12px; flex-wrap:wrap; }
.arch-box {
  background: var(--panel); border:1px solid var(--border); border-radius:12px;
  padding:14px 20px; flex:1; min-width:140px;
  display:flex; flex-direction:column; gap:4px;
}
.arch-box.primary { border-color:rgba(0,229,200,0.3); background:rgba(0,229,200,0.05); }
.arch-box.secondary { border-color:rgba(139,92,246,0.3); background:rgba(139,92,246,0.05); }
.arch-box.tertiary { border-color:rgba(255,209,102,0.3); background:rgba(255,209,102,0.05); }
.arch-box-title { font-family:'Syne',sans-serif; font-size:12px; font-weight:700; }
.arch-box-sub { font-size:10px; color:var(--muted); }
.arch-arrow { text-align:center; margin:8px 0; font-size:20px; color:var(--border); }

/* ── FLOW DIAGRAM ── */
.flow-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:24px; }
.flow-card {
  background:var(--panel); border:1px solid var(--border); border-radius:16px;
  padding:28px; position:relative; overflow:hidden;
}
.flow-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,var(--teal),var(--violet));
}
.flow-num { font-family:'Syne',sans-serif; font-size:48px; font-weight:800; opacity:0.05; position:absolute; top:16px; right:20px; line-height:1; }
.flow-icon { font-size:28px; margin-bottom:12px; }
.flow-title { font-family:'Syne',sans-serif; font-size:15px; font-weight:700; margin-bottom:8px; }
.flow-steps { list-style:none; }
.flow-steps li { font-size:11px; color:var(--muted); padding:4px 0; padding-left:16px; position:relative; }
.flow-steps li::before { content:'→'; position:absolute; left:0; color:var(--teal); }

/* ── COLOR SYSTEM ── */
.color-swatches { display:grid; grid-template-columns:repeat(auto-fill, minmax(160px,1fr)); gap:16px; }
.color-swatch { border-radius:12px; overflow:hidden; border:1px solid var(--border); }
.swatch-preview { height:80px; }
.swatch-info { padding:10px 12px; background:var(--panel); }
.swatch-name { font-size:11px; font-family:'Syne',sans-serif; font-weight:700; }
.swatch-hex { font-size:10px; color:var(--muted); }
.swatch-usage { font-size:9px; color:var(--muted); margin-top:2px; }

/* ── API ENDPOINTS ── */
.endpoint-list { display:flex; flex-direction:column; gap:8px; }
.endpoint-item { background:var(--ink2); border:1px solid var(--border); border-radius:10px; padding:12px 16px; display:flex; align-items:center; gap:12px; }
.method-badge { font-size:10px; font-weight:700; padding:3px 8px; border-radius:5px; font-family:'DM Mono',monospace; min-width:48px; text-align:center; flex-shrink:0; }
.method-badge.get { background:rgba(34,211,167,0.15); color:var(--success); }
.method-badge.post { background:rgba(0,229,200,0.15); color:var(--teal); }
.method-badge.put { background:rgba(255,181,71,0.15); color:var(--warning); }
.method-badge.del { background:rgba(255,107,107,0.15); color:var(--error); }
.endpoint-path { font-family:'DM Mono',monospace; font-size:12px; color:var(--text); flex:1; }
.endpoint-desc { font-size:11px; color:var(--muted); }

/* ── FOOTER ── */
.doc-footer {
  border-top:1px solid var(--border); padding:48px;
  display:flex; align-items:center; justify-content:space-between;
}
.footer-logo { font-family:'Syne',sans-serif; font-size:24px; font-weight:800; color:var(--teal); }
.footer-meta { font-size:11px; color:var(--muted); text-align:right; }

/* ── RESPONSIVE ── */
@media (max-width:768px) {
  .design-nav { padding:0 20px; }
  .hero { padding:80px 20px; }
